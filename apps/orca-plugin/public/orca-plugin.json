{
  "manifestVersion": 2,
  "id": "objectlens",
  "name": "ObjectLens",
  "version": "0.1.0",
  "description": "Explore JSON, YAML and Python repr() files as a searchable tree or graph, beside Source.",
  "icon": "icon.png",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "sandboxed-ui",
  "pluginApi": 1,
  "contributes": {
    "customEditors": [
      {
        "id": "objectlens",
        "title": "ObjectLens",
        "extensions": [".json", ".yaml", ".yml", ".repr", ".pyrepr", ".objectlens.json"],
        "entry": "editor.html",
        "frame": "isolated"
      }
    ]
  }
}
