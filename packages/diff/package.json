{
  "name": "@objectlens/diff",
  "version": "0.1.0",
  "type": "module",
  "description": "Structural diff of two ObjectLens graphs, independent of the formats that produced them.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@objectlens/core": "workspace:*"
  },
  "devDependencies": {
    "@objectlens/adapter-json": "workspace:*",
    "@objectlens/adapter-python": "workspace:*",
    "@objectlens/adapter-yaml": "workspace:*"
  }
}
