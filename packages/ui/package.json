{
  "name": "@objectlens/ui",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "The ObjectLens React UI: modes, panels, viewer state and the parse worker, shared by every ObjectLens app.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./markdown": {
      "types": "./src/modes/MarkdownMode.tsx",
      "default": "./src/modes/MarkdownMode.tsx"
    },
    "./styles.css": "./src/index.css"
  },
  "scripts": {
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@objectlens/adapter-json": "workspace:*",
    "@objectlens/adapter-python": "workspace:*",
    "@objectlens/adapter-snapshot": "workspace:*",
    "@objectlens/adapter-yaml": "workspace:*",
    "@objectlens/core": "workspace:*",
    "@objectlens/diff": "workspace:*",
    "@objectlens/icons": "workspace:*",
    "@objectlens/view-graph": "workspace:*",
    "@objectlens/view-tree": "workspace:*",
    "@tanstack/react-virtual": "^3.13.12",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0"
  }
}
